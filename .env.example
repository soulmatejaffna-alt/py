# Required: shared secret with the main app.
# The client sends `Authorization: Bearer <CRAWLER_API_KEY>` on every request.
# Use the SAME value as @canonlayer/crawler so either backend can serve the main app.
CRAWLER_API_KEY=change-me-to-a-long-random-string

# Optional: override the listen port (default 8080).
PORT=8080

# Optional: Playwright launch options
# CRAWLER_HEADLESS=true
# CRAWLER_MAX_CONCURRENCY=3
